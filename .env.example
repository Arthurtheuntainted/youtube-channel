# Cavern Wireless Configuration
# Copy this file to .env and fill in your values

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json

# Ollama (Local AI) Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Piper TTS Configuration
TTS_ENGINE_PATH=C:/piper/piper.exe
TTS_MODEL_PATH=C:/piper/voices/en_US-lessac-medium.onnx
TTS_VOICE=en_US-lessac-medium
TTS_SPEED=1.0

# Web Interface Configuration
WEB_HOST=127.0.0.1
WEB_PORT=5000

# Audio Output Configuration
AUDIO_OUTPUT_DEVICE=VB-Audio Virtual Cable

# Admin Credentials (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeMe123!

# Moderation Settings
# Set to "true" to require manual admin approval before broadcasting
REQUIRE_ADMIN_APPROVAL=false
